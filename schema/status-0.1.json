{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hadan8977/agent-status-signal/blob/main/schema/status-0.1.json",
  "type": "object",
  "required": [
    "v",
    "type",
    "source",
    "agentId",
    "state",
    "since"
  ],
  "properties": {
    "v": {
      "const": "0.1"
    },
    "type": {
      "const": "agent.status"
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$"
    },
    "agentId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": [
        "string",
        "null"
      ]
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "workspace": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "idle",
        "working",
        "needs-approval",
        "needs-input",
        "stuck",
        "done",
        "failed"
      ]
    },
    "activity": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "lastProgressAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "stuckReason": {
      "enum": [
        "no-output",
        "repeating",
        "retrying",
        "waiting-external",
        null
      ]
    },
    "progress": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "done": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "request": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "kind",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "approval",
            "question"
          ]
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "ok",
            "error",
            "cancelled",
            "refused"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "urgency": {
      "enum": [
        "low",
        "normal",
        "high",
        null
      ]
    },
    "closed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "needs-approval",
              "needs-input"
            ]
          }
        }
      },
      "then": {
        "required": [
          "request"
        ],
        "properties": {
          "request": {
            "type": "object"
          }
        }
      }
    }
  ],
  "additionalProperties": true
}